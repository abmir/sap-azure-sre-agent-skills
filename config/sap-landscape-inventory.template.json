{
  "environment": "<environment-name>",
  "subscription_id": "<subscription-id>",
  "storage_account": "<config-storage-account-name>",
  "description": "SAP landscape inventory — source of truth for all SRE Agent skills. Upload this file to the SRE Agent Knowledge Sources after filling in your systems. Delete every _comment / example system and add your own.",

  "how_to_generate": [
    "Option 1: Fill this template manually based on your SAP landscape",
    "Option 2: Ask the SRE Agent: 'Build SAP landscape inventory from Azure Resource Graph'",
    "Option 3: Ask the SRE Agent: 'Import SAP landscape from CSV' and paste your data",
    "Option 4: The config collector registry endpoint returns this data automatically if the collector cron job is configured"
  ],

  "_field_reference": {
    "_note": "Every system MUST set architecture + deployment. Together they form the canonical topology. The eight examples below show one of each. Copy the one that matches, rename, and fill in your VMs.",
    "architecture": {
      "scale-up": "HANA DB runs on a SINGLE node (one DB VM per replica). Vertical scaling.",
      "scale-out": "HANA DB is PARTITIONED across a master + N worker nodes (optionally + standby). Horizontal scaling for very large DBs (BW/4HANA, large S/4)."
    },
    "deployment": {
      "standalone": "All SAP tiers on ONE VM (DB + ASCS + PAS). No redundancy. Dev/sandbox. (scale-out standalone = one master+workers, single app, no HA).",
      "distributed": "DB, ASCS, and one or more App servers on SEPARATE VMs. Still no cluster / no failover.",
      "high-availability": "In-region redundancy: Pacemaker cluster + HANA System Replication (HSR, sync/syncmem) + ASCS/ERS clustered. Survives a node or zone failure.",
      "disaster-recovery": "HA in the primary region PLUS an async replica (HSR async) in a second Azure region. Survives a region failure."
    },
    "type_enum": [
      "scaleup-standalone", "scaleup-distributed", "scaleup-ha", "scaleup-dr",
      "scaleout-standalone", "scaleout-distributed", "scaleout-ha", "scaleout-dr"
    ],
    "vm_fields": {
      "roles": "Any of: db | ascs | ers | pas | app | aas | webdisp. A standalone VM lists all of [db, ascs, pas].",
      "ha_role": "primary | secondary | dr | none. For DB: HSR primary/secondary and the DR async target = 'dr'. For ASCS/ERS: the ASCS-holding node = primary.",
      "node_role": "SCALE-OUT ONLY. master | worker | standby. Omit for scale-up.",
      "site": "HSR site label (e.g. site-a / site-b) and 'dr' for the DR region set. Omit for standalone/distributed.",
      "region": "Azure region of this VM. Required for DR systems (primary vs DR region differ)."
    },
    "skill_applicability": "HA Cluster Health, Self-Healing (cluster actions) and the Pacemaker layer of Operational Health / Incident Analysis apply ONLY when deployment is 'high-availability' or 'disaster-recovery'. Resiliency Assessment scores DR posture using architecture + deployment + regions. All other skills apply to every topology."
  },

